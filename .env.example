APP_ENV=development
LISTEN_ADDRESS=:8080
REPOSITORY_MODE=memory
DATABASE_URL=postgres://crane_guard:crane_guard@postgres:5432/crane_guard?sslmode=disable
ACCESS_TOKEN_SECRET=replace-with-at-least-24-random-characters
SIMULATOR_KEY=replace-local-simulator-key
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=15s
ALLOWED_ORIGINS=http://localhost:5173
FILE_ROOT=./var/files
FILE_MAX_BYTES=10485760
WEB_DIST=./web/dist
SEED_DEMO=true
